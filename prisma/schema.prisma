generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MUNICIPAL
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEW
  APPROVED
  REJECTED
}

enum NotificationType {
  STATUS_UPDATE
  NEW_MESSAGE
  ASSIGNMENT
  SYSTEM
}

enum DocumentType {
  DIPLOMA
  STUDENT_CARD
  TRANSCRIPT
  ENROLLMENT_CERTIFICATE
  OTHER
}

model User {
  id                      String                    @id @default(uuid())
  firstName               String
  lastName                String
  email                   String                    @unique
  password                String
  phone                   String?
  address                 String?
  avatar                  String?
  role                    Role                      @default(STUDENT)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  refreshTokens           RefreshToken[]
  applications            Application[]             @relation("ApplicationOwner")
  assignedApplications    Application[]             @relation("ApplicationAssignee")
  notifications           Notification[]
  conversationLinks       ConversationParticipant[]
  sentMessages            Message[]                 @relation("MessageSender")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Scholarship {
  id          String   @id @default(uuid())
  title       String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  deadline    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id           String              @id @default(uuid())
  reference    String              @unique
  userId       String
  status       ApplicationStatus   @default(DRAFT)
  university   String
  program      String
  level        String
  year         String
  amount       Decimal             @db.Decimal(12, 2)
  motivation   String
  assignedToId String?
  reviewNote   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  submittedAt  DateTime?
  user         User                @relation("ApplicationOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?               @relation("ApplicationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  documents    ApplicationDocument[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
}

model ApplicationDocument {
  id            String       @id @default(uuid())
  applicationId String
  name          String
  type          DocumentType
  fileType      String
  size          Int
  url           String
  uploadedAt    DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
